/* REVEX_PROJECT_ACCESS_R43_BEGIN
 * Project data is collaborative inside the existing LIBER owner/member/admin
 * boundary. This block is injected into the live database match by the r43
 * publisher; it is deliberately not a standalone ruleset.
 */
function revexR43SignedIn() {
  return request.auth != null;
}

function revexR43IsAdmin() {
  // Auth custom claims are server-issued. Never trust users/{uid}.role, because
  // this fragment cannot revoke an allow granted by an unrelated preserved rule.
  return revexR43SignedIn() && (
    (request.auth.token.keys().hasAny(['revexAdmin']) && request.auth.token.revexAdmin == true)
    || (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'admin')
  );
}

function revexR43MemberOf(data) {
  return revexR43SignedIn() && (
    (data.keys().hasAny(['ownerId']) && data.ownerId == request.auth.uid)
    || (data.keys().hasAny(['memberIds']) && data.memberIds is list && request.auth.uid in data.memberIds)
  );
}

function revexR43ProjectRecordMember(projectId) {
  return exists(/databases/$(database)/documents/projects/$(projectId))
    && revexR43MemberOf(get(/databases/$(database)/documents/projects/$(projectId)).data);
}

function revexR43ProjectMember(projectId) {
  return revexR43IsAdmin() || revexR43ProjectRecordMember(projectId);
}

function revexR43ProjectOwner(projectId) {
  return revexR43SignedIn()
    && exists(/databases/$(database)/documents/projects/$(projectId))
    && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
}

function revexR43LinkedProjectMember(data) {
  return data.keys().hasAny(['linkedProjectId'])
    && data.linkedProjectId is string
    && revexR43ProjectRecordMember(data.linkedProjectId);
}

function revexR43SpecRecordMember(specProjectId) {
  return exists(/databases/$(database)/documents/specProjects/$(specProjectId))
    && (
      revexR43MemberOf(get(/databases/$(database)/documents/specProjects/$(specProjectId)).data)
      || revexR43LinkedProjectMember(get(/databases/$(database)/documents/specProjects/$(specProjectId)).data)
    );
}

function revexR43SpecMember(specProjectId) {
  return revexR43IsAdmin() || revexR43SpecRecordMember(specProjectId);
}

function revexR43ImmutableLibraryId(libraryId) {
  return libraryId.matches('^revex_engineering_revision_.*')
    || libraryId.matches('^revex_energy_result_.*')
    || libraryId.matches('^revex_revision_.*')
    || libraryId.matches('^revex_daily_report_.*');
}

function revexR43ValidRenderRequest(jobId) {
  return revexR43SignedIn()
    && jobId.matches('^render_[A-Za-z0-9_-]{16,80}$')
    && request.resource.data.keys().hasAll([
      'schema', 'type', 'hidden', 'revexKind', 'revexId',
      'provider', 'model', 'status', 'sourceRevision',
      'createdAt', 'updatedAt', 'createdBy'
    ])
    && request.resource.data.keys().hasOnly([
      'schema', 'type', 'hidden', 'revexKind', 'revexId',
      'contextKind', 'contextLabel', 'elementId', 'designItemId', 'chapterId',
      'revision', 'renderLocation', 'sourceCamera', 'sourceRevision', 'settings',
      'provider', 'model', 'status', 'createdAt', 'updatedAt', 'createdBy'
    ])
    && request.resource.data.schema == 'liber.revex.google-render-job.v1'
    && request.resource.data.type == 'revex'
    && request.resource.data.hidden == true
    && request.resource.data.revexKind == 'render'
    && request.resource.data.revexId == jobId
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.provider == 'google-gemini-server'
    && request.resource.data.model == 'gemini-3.1-flash-image'
    && request.resource.data.status == 'PREPARED'
    && request.resource.data.sourceRevision is string
    && request.resource.data.sourceRevision.size() <= 160
    && request.resource.data.createdAt is string
    && request.resource.data.updatedAt is string;
}

function revexR43ImmutableProjectLane(projectCollection) {
  return projectCollection == 'revexRevisions'
    || projectCollection == 'revexHistory'
    || projectCollection == 'revexEnergyJobs'
    || projectCollection == 'revexRenders'
    || projectCollection == 'revexRenderJobs'
    || projectCollection == 'revexReportJobs'
    || projectCollection == 'revexEnergyConsents';
}

/* Secure Chat stays the Chat data owner. REVEX only guarantees that a signed-in
 * participant can use the connection they actually belong to. No public chat
 * reads and no cross-connection message access are introduced here. */
function revexR43ChatMemberOf(data) {
  return revexR43SignedIn()
    && revexR43ChatProjectBoundary(data)
    && (
      (data.keys().hasAny(['participants']) && data.participants is list && request.auth.uid in data.participants)
      || (data.keys().hasAny(['users']) && data.users is list && request.auth.uid in data.users)
      || (data.keys().hasAny(['memberIds']) && data.memberIds is list && request.auth.uid in data.memberIds)
      || (data.keys().hasAny(['admins']) && data.admins is list && request.auth.uid in data.admins)
    );
}

function revexR43ChatMember(connId) {
  return exists(/databases/$(database)/documents/chatConnections/$(connId))
    && revexR43ChatMemberOf(get(/databases/$(database)/documents/chatConnections/$(connId)).data);
}

function revexR43ChatAdmin(connId) {
  return revexR43SignedIn()
    && exists(/databases/$(database)/documents/chatConnections/$(connId))
    && revexR43ChatProjectBoundary(get(/databases/$(database)/documents/chatConnections/$(connId)).data)
    && get(/databases/$(database)/documents/chatConnections/$(connId)).data.keys().hasAny(['admins'])
    && get(/databases/$(database)/documents/chatConnections/$(connId)).data.admins is list
    && request.auth.uid in get(/databases/$(database)/documents/chatConnections/$(connId)).data.admins;
}

function revexR43ProjectChat(data) {
  return data.keys().hasAll(['projectId', 'type'])
    && data.projectId is string
    && data.type == 'project';
}

function revexR43ChatProjectBoundary(data) {
  // Explicit chat membership is insufficient for a Project Chat. A removed
  // project member loses connection, message and attachment access immediately,
  // even before the controller has reconciled the denormalized participant list.
  return !revexR43ProjectChat(data) || revexR43ProjectRecordMember(data.projectId);
}

function revexR43ProjectChatBindingUntouched() {
  return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
    'participants', 'users', 'memberIds', 'admins',
    'projectId', 'type', 'key', 'projectKey', 'cryptoLegacySalts'
  ]);
}

function revexR43ProjectChatBindingAbsent(data) {
  return !data.keys().hasAny([
    'chatConnId', 'chatProjectSchema', 'chatSourceCandidate', 'chatUpdatedAt'
  ]);
}

function revexR43BrowserChatIsNotProject(data) {
  return !revexR43ProjectChat(data)
    && (!data.keys().hasAny(['schema']) || data.schema != 'liber.revex.project-chat.v1')
    && (!data.keys().hasAny(['source']) || data.source != 'revex-project-chat');
}

function revexR43BrowserChatCreateAllowed(data) {
  return revexR43ChatMemberOf(data) && revexR43BrowserChatIsNotProject(data);
}

match /projects/{projectId} {
  allow get: if revexR43IsAdmin() || revexR43MemberOf(resource.data);
  allow list: if revexR43IsAdmin()
    || (revexR43SignedIn() && resource.data.ownerId == request.auth.uid)
    || (revexR43SignedIn() && request.auth.uid in resource.data.memberIds);
  allow create: if revexR43ProjectChatBindingAbsent(request.resource.data) && (
    revexR43IsAdmin() || (
      revexR43MemberOf(request.resource.data)
      && request.resource.data.ownerId == request.auth.uid
    )
  );
  // The Admin-SDK Project Chat controller owns these bindings. Browser clients,
  // including platform admins, cannot relink a project to an arbitrary room.
  allow update: if (
    revexR43IsAdmin() || (
      revexR43MemberOf(resource.data)
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.memberIds == resource.data.memberIds
    )
  )
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
      'chatConnId', 'chatProjectSchema', 'chatSourceCandidate', 'chatUpdatedAt'
    ]);
  allow delete: if revexR43IsAdmin() || revexR43ProjectOwner(projectId);

  /* immutableRevisionUpdateDeleteDenied
   * Immutable publication and audit records remain readable to project members.
   * The browser may create a new revision/history record, but no client identity,
   * including a LIBER admin, may rewrite or delete one after publication. Server
   * workers use the Admin SDK and are not governed by these client rules. */
  match /library/{libraryId} {
    allow read, create: if revexR43ProjectMember(projectId);
    allow update, delete: if revexR43ProjectMember(projectId)
      && !revexR43ImmutableLibraryId(libraryId);
  }

  match /revexRevisions/{revisionId} {
    allow read, create: if revexR43ProjectMember(projectId);
  }

  match /revexHistory/{historyId} {
    allow read, create: if revexR43ProjectMember(projectId);
  }

  match /revexEnergyJobs/{jobId} {
    allow read: if revexR43ProjectMember(projectId);
  }

  /* A browser may create exactly one caller-owned PREPARED request. From that
   * point forward only the Admin-SDK broker may accept, complete or fail it. */
  match /revexRenders/{jobId} {
    allow read: if revexR43ProjectMember(projectId);
    allow create: if revexR43ProjectMember(projectId)
      && revexR43ValidRenderRequest(jobId);
  }

  /* Render leases/results are created transactionally by the authenticated
   * server broker. Members may observe status, but no browser identity may
   * forge a job, reset its one-shot lease, or replace its result binding. */
  match /revexRenderJobs/{jobId} {
    allow read: if revexR43ProjectMember(projectId);
  }

  match /revexReportJobs/{jobId} {
    allow read: if revexR43ProjectMember(projectId);
  }

  match /revexEnergyConsents/{revisionId} {
    allow read: if revexR43ProjectMember(projectId);

    match /approvers/{approverUid} {
      allow read: if revexR43ProjectMember(projectId);
      allow create: if revexR43ProjectMember(projectId)
        && request.auth.uid == approverUid
        && request.resource.data.approvedByUid == request.auth.uid;
      // A consent's signed scope is immutable. Compatibility forms may append only
      // revision-scoped identity/review fields used by the current Energy workflow.
      allow update: if revexR43ProjectMember(projectId)
        && request.auth.uid == approverUid
        && resource.data.approvedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectIdentityOverride', 'projectIdentityOverrideAuthority',
          'projectIdentityOverrideRecordedAt', 'en1Applicant', 'en1Modeler',
          'en1IdentityAuthority', 'en1IdentityRecordedAt',
          'maintainerClarification', 'packageApproval'
        ]);
    }
  }

  match /{projectCollection}/{projectDocument=**} {
    allow read, write: if revexR43ProjectMember(projectId)
      && projectCollection != 'library'
      && !revexR43ImmutableProjectLane(projectCollection);
  }
}

match /specProjects/{specProjectId} {
  allow get: if revexR43IsAdmin()
    || revexR43MemberOf(resource.data)
    || revexR43LinkedProjectMember(resource.data);
  allow list: if revexR43IsAdmin()
    || (revexR43SignedIn() && resource.data.ownerId == request.auth.uid)
    || (revexR43SignedIn() && request.auth.uid in resource.data.memberIds)
    || revexR43LinkedProjectMember(resource.data);
  allow create: if revexR43IsAdmin() || (
    revexR43MemberOf(request.resource.data)
    && (
      !request.resource.data.keys().hasAny(['linkedProjectId'])
      || request.resource.data.linkedProjectId == null
      || revexR43LinkedProjectMember(request.resource.data)
    )
  );
  allow update: if revexR43IsAdmin() || (
    (revexR43MemberOf(resource.data) || revexR43LinkedProjectMember(resource.data))
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.memberIds == resource.data.memberIds
    && request.resource.data.linkedProjectId == resource.data.linkedProjectId
  );
  allow delete: if revexR43IsAdmin() || (
    revexR43SignedIn() && resource.data.ownerId == request.auth.uid
  );

  match /{specCollection}/{specDocument=**} {
    allow read, write: if revexR43SpecMember(specProjectId);
  }
}

match /chatConnections/{connId} {
  /* secureChatNoGlobalAdminBypass: even a LIBER-wide admin must be an explicit
   * participant. Chat membership is not inherited from project/admin roles. */
  allow get: if revexR43ChatMemberOf(resource.data);

  // Keep list rules field-specific. Firestore must be able to prove the exact
  // array-contains query constraint before executing it; one broad OR helper is
  // safe for a direct get but cannot be proven for a participants-only query.
  allow list: if revexR43SignedIn() && revexR43ChatProjectBoundary(resource.data) && request.auth.uid in resource.data.participants;
  allow list: if revexR43SignedIn() && revexR43ChatProjectBoundary(resource.data) && request.auth.uid in resource.data.users;
  allow list: if revexR43SignedIn() && revexR43ChatProjectBoundary(resource.data) && request.auth.uid in resource.data.memberIds;
  allow list: if revexR43SignedIn() && revexR43ChatProjectBoundary(resource.data) && request.auth.uid in resource.data.admins;

  // Only the Admin-SDK resolver may create a canonical Project Chat room. This
  // prevents a browser from pre-seeding the deterministic/query candidate and
  // having its messages or crypto lineage adopted into another project.
  allow create: if revexR43BrowserChatCreateAllowed(request.resource.data);
  allow update: if (
    revexR43ChatAdmin(connId)
    && (
      (revexR43ProjectChat(resource.data) && revexR43ProjectChatBindingUntouched())
      || (!revexR43ProjectChat(resource.data) && revexR43BrowserChatIsNotProject(request.resource.data))
    )
  ) || (
    revexR43ChatMemberOf(resource.data)
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
      'participants', 'users', 'memberIds', 'admins',
      'schema', 'source', 'sourceCandidate', 'projectId', 'type', 'key', 'projectKey', 'cryptoLegacySalts',
      'groupKeyVersion', 'groupKeyEpoch', 'groupKeyParticipantDigest',
      'groupKeyIssuerUid', 'groupKeyEnvelopes', 'groupKeyHistory',
      'groupKeyRotatedAt', 'keyRotationRequired'
    ])
  );
  allow delete: if revexR43ChatAdmin(connId);
}

/* New device identities are create-once. A client cannot silently replace a
 * published key and make peers encrypt to an attacker-controlled identity. */
match /userPublicKeys/{uid} {
  allow get: if revexR43SignedIn();
  allow create: if revexR43SignedIn()
    && request.auth.uid == uid
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.cryptoVersion == 'liber.secure-chat.identity-p256.v2'
    && request.resource.data.keys().hasAll(['uid', 'publicJwk', 'fingerprint', 'cryptoVersion', 'createdAt'])
    && request.resource.data.keys().hasOnly(['uid', 'publicJwk', 'fingerprint', 'cryptoVersion', 'createdAt']);
  allow update, delete, list: if false;
}

/* Raw push tokens and identity-recovery audit records are server-only. They are
 * intentionally outside user profile documents and are never client-readable. */
match /serverSecureState/{uid}/pushTokens/{tokenHash} {
  allow read, write: if false;
}

match /serverSecureState/chatPushReceipts/deliveries/{receiptId} {
  allow read, write: if false;
}

match /secureChatIdentityRecoveryAudit/{eventId} {
  allow read, write: if false;
}

match /chatMessages/{connId}/messages/{messageId} {
  allow read: if revexR43ChatMember(connId);
  allow create: if revexR43ChatMember(connId)
    && request.resource.data.keys().hasAll(['sender', 'connId'])
    && request.resource.data.sender == request.auth.uid
    && request.resource.data.connId == connId;
  allow update: if revexR43ChatMember(connId) && (
    (
      resource.data.keys().hasAny(['sender'])
      && resource.data.sender == request.auth.uid
      && request.resource.data.sender == request.auth.uid
      && request.resource.data.connId == connId
    )
    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'updatedAt'])
  );
  allow delete: if revexR43ChatAdmin(connId) || (
    revexR43ChatMember(connId)
    && resource.data.keys().hasAny(['sender'])
    && resource.data.sender == request.auth.uid
  );
}
/* REVEX_PROJECT_ACCESS_R43_END */
