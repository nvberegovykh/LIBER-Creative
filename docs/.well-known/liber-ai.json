{
  "schema": "liber.ai.discovery.v1",
  "name": "LIBER / REVEX",
  "sourceRepository": "https://github.com/nvberegovykh/LIBER-Creative",
  "defaultBranch": "main",
  "productionRoot": "https://liberpict.com/liber-apps/",
  "humanGuide": "https://github.com/nvberegovykh/LIBER-Creative/blob/main/AI_START_HERE.md",
  "principles": [
    "integrate-do-not-reconstruct",
    "one-concern-one-runtime-owner",
    "revit-remains-model-authority",
    "observe-before-and-after-every-consequential-transition",
    "focus-keys-are-not-authentication-secrets",
    "isolated-workshop-before-production-mutation"
  ],
  "observer": {
    "status": "candidate-read-only-core-with-isolated-workshop",
    "source": "docs/liber-apps/apps/revex/observer-focus-api-r143.js",
    "global": "window.RevexObserver",
    "methods": [
      "snapshot",
      "getElement",
      "query",
      "graph",
      "getSelection",
      "select",
      "createFocus",
      "getFocus",
      "listFocus",
      "updateFocus",
      "recordStep",
      "closeFocus",
      "preview"
    ],
    "nativeFamilyInspection": {
      "requestType": "liber:revex-observer-family-inspect-r144",
      "responseType": "liber:revex-observer-family-inspection-r144",
      "browserRecipe": "docs/liber-apps/apps/revex/observer-elevator-r144.js",
      "nativeService": "src/Liber.Revex.Revit/Services/ObserverFamilyService.cs",
      "nativeBridge": "src/Liber.Revex.Revit/UI/RevexObserverBridge.cs",
      "mutation": false,
      "opensFamilyWith": "Document.EditFamily",
      "closesFamilyWithSave": false
    },
    "isolatedWorkshop": {
      "status": "candidate",
      "productionMutation": false,
      "requestType": "liber:revex-observer-elevator-workshop-r146",
      "responseType": "liber:revex-observer-elevator-workshop-result-r146",
      "browserRuntime": "docs/liber-apps/apps/revex/observer-elevator-workshop-r146.js",
      "nativeService": "src/Liber.Revex.Revit/Services/ElevatorWorkshopService.cs",
      "nativeHandler": "src/Liber.Revex.Revit/Revit/RevexElevatorWorkshopExternalHandler.cs",
      "artifactRoot": "%TEMP%/LIBER_REVEX/observer-workshops",
      "rules": [
        "save-baseline-before-mutation",
        "one-named-revit-transaction-per-state",
        "reject-cascading-delete",
        "regenerate-before-acceptance",
        "preserve-wall-reference-dimension-nested-family-identities",
        "never-load-candidate-back-into-active-project"
      ]
    },
    "focusKey": {
      "field": "focusId",
      "secret": false,
      "meaning": "Task locator inside the currently authorized REVEX project/session"
    },
    "mutationAvailable": false,
    "isolatedWorkshopAvailable": true
  },
  "provingFocuses": [
    {
      "id": "elevator.single-right",
      "observerGlobal": "window.RevexObserverElevator",
      "observerStartMethod": "start",
      "workshopGlobal": "window.RevexElevatorWorkshop",
      "workshopStartMethod": "proveS3",
      "target": "one right-aligned elevator entrance with one sliding panel and left-side panel pocket",
      "currentState": "S3 isolated rear-glass retirement candidate",
      "purpose": "Develop the Observer and the elevator repair together; missing evidence becomes a bounded Observer capability instead of a one-off script."
    }
  ],
  "runtimeOwners": [
    {
      "name": "revex-companion",
      "role": "Companion shell and BIM orchestration",
      "source": "docs/liber-apps/apps/revex/app.js"
    },
    {
      "name": "revex-store",
      "role": "Project identity, revision pointers and cloud/local store boundary",
      "source": "docs/liber-apps/apps/revex/store.js"
    },
    {
      "name": "rvx-export",
      "role": "Exact Revit geometry export",
      "source": "src/Liber.Revex.Revit/Services/RevexMeshExportService.cs"
    },
    {
      "name": "revit-request-owner",
      "role": "Native Revit request and ExternalEvent execution boundary",
      "source": "src/Liber.Revex.Revit/Revit/RevitRequestHandler.cs"
    },
    {
      "name": "revit-web-bridge",
      "role": "REVEX WebView2 to native Revit bridge",
      "source": "src/Liber.Revex.Revit/UI/RevexWebIntegrationBridge.cs"
    },
    {
      "name": "observer-native-family",
      "role": "Read-only deep Family Editor inspection through Revit itself",
      "source": "src/Liber.Revex.Revit/Services/ObserverFamilyService.cs"
    },
    {
      "name": "elevator-workshop",
      "role": "Detached family candidate transitions only; never active-project authority",
      "source": "src/Liber.Revex.Revit/Services/ElevatorWorkshopService.cs"
    },
    {
      "name": "wallt-control-plane",
      "role": "Helper/fixer orchestration over existing owners",
      "source": "docs/liber-apps/apps/revex/wallt-control-plane.js"
    },
    {
      "name": "wallt-fixer-adapters",
      "role": "Bounded local fixer adapters",
      "source": "docs/liber-apps/apps/revex/wallt-fixer-adapters-r137.js"
    },
    {
      "name": "firebase-broker",
      "role": "Authenticated cloud function and broker boundary",
      "source": "server/firebase-functions/index.js"
    },
    {
      "name": "energy-worker",
      "role": "Current managed Energy worker",
      "source": "server/revex-energy-worker/app.py"
    }
  ],
  "security": {
    "repositorySecretsAllowed": false,
    "focusRecordsMayContainSecrets": false,
    "browserAuth": "existing-authorized-revex-session",
    "headlessCapabilityToken": {
      "status": "not-yet-exposed",
      "requirements": [
        "server-issued",
        "short-lived",
        "project-scoped",
        "focus-scoped",
        "action-scoped",
        "revocable",
        "never-logged-or-committed"
      ]
    }
  },
  "sourceParity": {
    "customDomainSource": "docs/CNAME",
    "expectedDomain": "liberpict.com",
    "rule": "Do not assume live byte parity from repository presence alone; verify the live asset fingerprint before production mutation."
  }
}
