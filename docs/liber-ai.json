{
  "schema": "liber.ai.discovery.v1",
  "name": "LIBER / REVEX",
  "canonicalApi": {
    "name": "LIBER REVEX Observer API",
    "shortName": "REVEX Observer",
    "discoveryUri": "https://liberpict.com/liber-ai.json",
    "counter": "https://liberpict.com/observer-ai.html",
    "machineGuide": "https://liberpict.com/observer-ai-guide.json",
    "humanGuide": "https://github.com/nvberegovykh/LIBER-Creative/blob/main/AI_START_HERE.md",
    "publicIssueEndpoint": "https://us-central1-liber-apps-cca20.cloudfunctions.net/issueRevexObserverAnonymousClaim",
    "claimEndpoint": "https://us-central1-liber-apps-cca20.cloudfunctions.net/claimRevexObserverAgentSession",
    "mcpEndpoint": "https://us-central1-liber-apps-cca20.cloudfunctions.net/revexObserverMcp",
    "instruction": "Check https://liberpict.com/ai/continue.json first. For a matching public handoff, continue in the current chat from public assets; Work mode, Observer claim and Pair AI are not prerequisites. Use the Observer claim/pairing flow only when private REVEX project data is actually required."
  },
  "observer": {
    "agentAccess": {
      "status": "live-read-only-observer-with-separate-project-pairing",
      "counterAccountRequired": false,
      "counterExposesProjectData": false,
      "projectAuthorization": "one-time Pair AI code issued inside an authorized REVEX project session",
      "pairTool": "observer_pair",
      "claimTtlMinutes": 10,
      "pairCodeTtlMinutes": 10,
      "sessionTtlHours": 2,
      "initialScopes": [
        "observer.pair"
      ],
      "pairedScopes": [
        "observer.read",
        "observer.preview",
        "observer.focus"
      ],
      "mutation": false
    },
    "focusKey": {
      "field": "focusId",
      "secret": false,
      "meaning": "Task locator inside the currently authorized REVEX project/session"
    }
  },
  "security": {
    "repositorySecretsAllowed": false,
    "publicCounter": {
      "accountRequired": false,
      "projectDataExposed": false,
      "claimSingleUse": true,
      "rateLimited": true
    }
  },
  "principles": [
    "slice-do-not-replace",
    "preserve-identity-across-projections",
    "separate-object-state-from-observer-state",
    "declare-lossy-abstraction-boundaries",
    "paper-before-render",
    "major-form-before-artifacts",
    "task-validity-is-conjunctive",
    "explicit-basis-before-projection",
    "isometry-is-a-special-case-of-axonometry",
    "vector-markup-constrains-does-not-mutate",
    "projected-coincidence-does-not-delete-object-features"
  ],
  "modelAgnosticGuidance": {
    "projectionDiscipline": "Use ordered lower-dimensional slices to inspect a richer state while preserving identity across slices. Do not let a correct abstraction replace the object.",
    "humanCommunication": "Separate observation, deterministic transformation, and inference; preserve unresolved uncertainty instead of hiding it with fluent wording.",
    "guide": "https://liberpict.com/observer-ai-guide.json"
  },
  "workflows": {
    "paperBeforeRender": {
      "uri": "https://liberpict.com/ai/workflows/projection-render-gate.json",
      "humanLaunchRequired": true,
      "renderDefault": "blocked-until-paper-ready-and-human-launch"
    },
    "objectPaper": {
      "schema": "https://liberpict.com/ai/schemas/object-paper-v1.schema.json",
      "runtime": "https://liberpict.com/ai/runtime/object-paper-r1.js",
      "example": "https://liberpict.com/ai/examples/four-candle-lantern.object-paper.json",
      "readinessFunction": "LiberObjectPaper.evaluatePaperReady",
      "renderBlockedUntilReady": true
    },
    "dependencyGraph": {
      "schema": "https://liberpict.com/ai/schemas/dependency-graph-v1.schema.json",
      "runtime": "https://liberpict.com/ai/runtime/dependency-graph-r1.js",
      "purpose": "Deterministic formula DAG, propagation, cycle detection and render-eligibility tracing."
    }
  },
  "currentPublicHandoffsIndex": "https://liberpict.com/ai/cases/index.json",
  "publicContinuation": {
    "entrypoint": "https://liberpict.com/ai/continue.json",
    "precedence": "before-observer-for-matching-public-task",
    "requiresWorkMode": false,
    "requiresObserverLease": false,
    "requiresPairAI": false,
    "declinedWorkHandoffIsBlocker": false,
    "instruction": "If the human task matches a current public handoff, continue in the current chat from public assets. Use Observer/Pair AI only if private REVEX project data is actually required."
  }
}
