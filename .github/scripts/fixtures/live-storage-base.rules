rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Representative unrelated live rule. Merge QA proves this survives REVEX.
    match /avatars/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
